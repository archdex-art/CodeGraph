{
  // `tsconfig.json` drives the shipped `tsc` emit, so its `include` is
  // deliberately narrow: only `src/` and `shared/` may land in `dist/`.
  // Typechecking has no such constraint, so widen it here to also cover the
  // Playwright suite and the build-orchestration scripts — otherwise the two
  // parts of the tree that are never executed by `vitest` would carry no
  // automated verification at all.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*", "shared/**/*", "e2e/**/*", "scripts/**/*"]
}
