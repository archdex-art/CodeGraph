# Dependencies
node_modules/
**/node_modules/

# Next.js build output
.next/
out/
next-env.d.ts
*.tsbuildinfo

# App runtime data. The WHOLE directory, not an enumeration of the kinds of file
# seen so far: the previous version listed *.sqlite* and workspaces/, and then
# `data/timeline/` appeared and 115k lines of indexed-repo snapshots were committed
# past it. Nothing under here belongs to this repo's history — the SQLite DB and the
# cloned target repos live on the Render disk, and the container creates the dir.
apps/web/data/

# Compiled worker. Built inside the Docker builder stage
# (`RUN npm run build --workspace @codegraph/worker`) and copied from there, so a
# committed copy is never the one that runs — only noise in every diff that touches it.
apps/*/dist/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Env & secrets
.env
.env*.local

# Misc
.DS_Store
*.log
